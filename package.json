{
  "name": "dsh-literature-agents",
  "version": "1.0.0",
  "type": "module",
  "description": "文学与古典文献领域专家插件：9 个文献工具（论文检索、学人生平、古籍全文与今译/英译、引用核验）、11 位文史专家子代理、3 个评审团，另带一个输入区「古籍」开关。适配 DeepSeek Harness 0.2.1-rc.2。",
  "main": "./index.js",
  "scripts": {
    "smoke": "node dev/register-smoke.mjs && node dev/client-smoke.mjs",
    "smoke:host": "node dev/register-smoke.mjs",
    "smoke:client": "node dev/client-smoke.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./experts": "./experts.js",
    "./sources": "./sources.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "experts.js",
    "sources.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "skills/**",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "engines": {
      "dsh": ">=0.2.1-rc.2 <0.3.0 || >=0.3.0-rc.1 <0.4.0-0"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/dsh-literature-agents.git"
  },
  "homepage": "https://github.com/OWNER/dsh-literature-agents#readme",
  "bugs": {
    "url": "https://github.com/OWNER/dsh-literature-agents/issues"
  },
  "author": "yujh129 <3167481312@qq.com>",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "literature",
    "classics",
    "historiography",
    "translation",
    "digital-humanities"
  ],
  "license": "MIT"
}
